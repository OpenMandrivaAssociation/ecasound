+# automake has no recipe for a $(top_builddir) convenience library, so a
+# parallel build fails before plugins/ has finished linking it.
+$(top_builddir)/libecasound/plugins/libecasound_plugins.la:
+	$(MAKE) $(AM_MAKEFLAGS) -C $(top_builddir)/libecasound/plugins libecasound_plugins.la
+$(top_builddir)/libecasound/plugins/libecasound_plugins_debug.la:
+	$(MAKE) $(AM_MAKEFLAGS) -C $(top_builddir)/libecasound/plugins libecasound_plugins_debug.la
+
 
